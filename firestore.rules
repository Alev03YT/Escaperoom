rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBootstrapAdmin(uid) {
      return signedIn()
        && request.auth.uid == uid
        && request.auth.uid == 'SkaKMDb25qSDOkR9uVFWpYr666C3'
        && request.auth.token.email == 'alessandro.valerio03@gmail.com';
    }

    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if isBootstrapAdmin(uid)
        && request.resource.data.active == true
        && request.resource.data.role == 'admin'
        && request.resource.data.email == 'alessandro.valerio03@gmail.com';
      allow update: if isAdmin() && request.auth.uid == uid;
      allow delete: if false;
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /settings/{documentId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /progress/{uid} {
      allow read, create, update: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
      allow delete: if false;
    }

    match /completions/{completionId} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
